rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public serve-day gallery (photos & videos uploaded by team).
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Profile photos: public read (for avatars in UI); only owner can write; images only, max ~3MB.
    match /volunteer_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Team uploads (photos/videos) — owner read/write; large files OK for b-roll.
    match /volunteer_media/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 100 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*'));
    }

    // Nigeria unit vision/report photos — public read (PDF + board story); signed-in write.
    // Content-type check is lenient because some mobile browsers send empty/octet-stream types.
    match /nigeria_unit_media/{unitId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType == ''
        );
    }

    // Class of David staff prep (class material + Sample HW). Coordinators and President only.
    function isCodAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == 'ddbs.htx@gmail.com'
          || request.auth.token.email == 'abuxberkeley@gmail.com'
        );
    }
    function isCodCoordinator() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.codRole == 'coordinator'
          || request.auth.token.codRole == 'admin'
          || request.auth.token.email.lower() == 'cissydupsy@gmail.com'
          || request.auth.token.email.lower() == 'ekojaveronica26@gmail.com'
          || request.auth.token.email.lower() == 'nnodumamara28@gmail.com'
          || request.auth.token.email.lower() == 'ojelizzy2@gmail.com'
        );
    }
    match /cod/staff/{allPaths=**} {
      allow read: if isCodAdmin() || isCodCoordinator();
      allow write: if false;
    }

    // Approved homework PDFs sent to students.
    match /cod/published/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isCodAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Student homework uploads (PDF, JPG, PNG). Student writes; staff can review.
    match /cod/submissions/{studentUid}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == studentUid || isCodAdmin() || isCodCoordinator());
      allow write: if request.auth != null
        && request.auth.uid == studentUid
        && request.resource.size < 12 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'application/octet-stream'
        );
    }
  }
}
